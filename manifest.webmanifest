{
  "id": "scanlet",
  "name": "Scanlet — private document scanner",
  "short_name": "Scanlet",
  "description": "Scan, clean up, OCR and assemble PDFs entirely in your browser. Nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f6fa",
  "theme_color": "#4f46e5",
  "dir": "ltr",
  "lang": "en",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Import files",
      "short_name": "Import",
      "description": "Add images or PDFs from this device",
      "url": "./?action=import",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Capture with the camera",
      "short_name": "Camera",
      "description": "Scan pages with this device's camera",
      "url": "./?action=camera",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Scan a printer",
      "short_name": "Printer",
      "description": "Scan from a printer on your network",
      "url": "./?action=scanner",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "application/pdf", ".pdf"] }
      ]
    }
  }
}
